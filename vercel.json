{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.py": {
      "maxDuration": 10,
      "includeFiles": [
        "api/catalog.json"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/projects", "destination": "/api/projects.py" },
    { "source": "/api/summary", "destination": "/api/summary.py" },
    { "source": "/api/(.*)", "destination": "/api/$1.py" }
  ]
}
